{
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/club", "destination": "/index.html" },
    { "source": "/club/", "destination": "/index.html" },
    { "source": "/carta", "destination": "/index.html" },
    { "source": "/carta/", "destination": "/index.html" },
    { "source": "/local", "destination": "/index.html" },
    { "source": "/local/", "destination": "/index.html" }
  ]
}
